# Backend
EAUDIT_DATABASE_URL=postgresql+psycopg2://eaudit:eaudit@localhost:5433/eaudit
EAUDIT_CORS_ORIGINS=http://localhost:5173

# AI layer (used by later-phase AI features; demo/synthetic data only). The model is a
# LiteLLM provider-prefixed string — change this one value to move every AI feature to a
# different model or provider; nothing else in the app needs to change.
# Copy this file to .env and paste your own key. NEVER commit a real key.
EAUDIT_LLM_MODEL=anthropic/claude-opus-5
# The credential env var LiteLLM reads is whichever the configured provider expects — for
# "anthropic/..." models that's ANTHROPIC_API_KEY, resolved automatically, not by app code.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# To swap providers, change EAUDIT_LLM_MODEL and set that provider's own credential instead, e.g.:
# EAUDIT_LLM_MODEL=openai/gpt-4o
# OPENAI_API_KEY=sk-your-openai-key-here

# EAUDIT_LLM_BASE_URL=  # prod: point at an in-VPC/self-hosted gateway instead of the public API
# EAUDIT_EMBEDDING_MODEL=  # reserved for a future embedding-based retrieval feature; unused today
